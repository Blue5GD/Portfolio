---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <main class="skeleton">
    <h1 class="wordmark">Blue5GD</h1>
    <p>Micah Winesberry</p>
    <p class="muted">Site under construction. Body text is Inter, headings are Lilita One.</p>
    <a href={`${base}Micah-Winesberry-Resume.pdf`}>Resume (PDF)</a>
  </main>
</BaseLayout>

<style>
  /* Styles in an Astro <style> tag only apply to this file's elements. */
  .skeleton {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  .skeleton h1 {
    font-size: clamp(3rem, 10vw, 6rem);
  }
  .muted {
    color: var(--text-muted);
  }
</style>
