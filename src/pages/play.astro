---
// Game mode. The level select and the canvas are the shell; the engine in
// src/game/ draws the course. Dialogs stay HTML so the text can be selected
// and read by a screen reader.
//
// The JSON tag below is the portfolio text, copied from src/data at build
// time. panels.ts reads it when an info block opens. The classic page reads
// the same files, so the words stay in one place.
import BaseLayout from "../layouts/BaseLayout.astro";
import { about } from "../data/about";
import { awards } from "../data/awards";
import { education } from "../data/education";
import { experience } from "../data/experience";
import { featured } from "../data/featured";
import { hallOfFame } from "../data/hallOfFame";
import { identity } from "../data/identity";
import { projects } from "../data/projects";
import { skills } from "../data/skills";

const base = import.meta.env.BASE_URL;

function shortUrl(href: string): string {
  return href.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
}

const gameContent = {
  about,
  featured,
  projects,
  experience,
  awards,
  skills,
  education,
  contact: {
    email: identity.email,
    github: identity.github,
    githubLabel: shortUrl(identity.github),
    linkedin: identity.linkedin,
    linkedinLabel: shortUrl(identity.linkedin),
    resumeHref: `${base}${identity.resumeFile}`,
  },
};
---

<BaseLayout
  title="Play | Blue5GD"
  description="A platformer through Micah Winesberry's portfolio. Clear a level in normal mode. Practice and skip unlock the next level without clearing it."
  mode="play"
>
  <main class="shell">
    <section id="level-select" class="select" aria-labelledby="select-title">
      <div class="select-inner">
        <h1 id="select-title">Level select</h1>
        <p class="intro">
          Clear a level with Practice off to mark it cleared. Finishing in Practice, or skipping, unlocks the next level but does not clear it. Skip also reads every panel if you want the writing without the jumps.
        </p>
        <aside class="keyboard-note">
          <p>
            The platformer needs a keyboard, so it is not available on a phone or a narrow window.
            The same writing is on the Classic page. On-screen buttons are a possible addition later, not part of the site today.
          </p>
          <a class="gd-btn" href={base}>Back to Classic</a>
        </aside>
        <div id="level-cards" class="cards"></div>
        <aside class="hall" aria-labelledby="hall-title">
          <h2 id="hall-title">Hall of Fame</h2>
          <p>
            Clear The Final Battle with Practice off, then email{" "}
            <a href={`mailto:${identity.email}`}>{identity.email}</a>{" "}
            a YouTube video of the completion to be added. The video has to include audio of you pressing the keys, so the keyboard can be heard, not just the game. An accepted run is listed with a username you choose, the date you finished, and a link to the video.
          </p>
          {
            hallOfFame.length === 0 ? (
              <p class="hall-empty">No one is listed yet.</p>
            ) : (
              <ul class="hall-list">
                {hallOfFame.map((entry) => (
                  <li>
                    <span class="hall-name">{entry.username}</span>
                    <span class="hall-date">{entry.date}</span>
                    <a href={entry.videoUrl} target="_blank" rel="noopener">Video</a>
                  </li>
                ))}
              </ul>
            )
          }
        </aside>
      </div>
      <div class="select-inner">
        <p id="attempt-total" class="attempts" aria-live="polite"></p>
        <div class="select-actions">
          <label class="volume">
            Volume
            <input type="range" min="0" max="100" step="1" value="60" data-volume aria-label="Music volume" />
          </label>
          <button id="mute-select" class="gd-btn gd-btn--alt" type="button" data-mute aria-pressed="false">Mute</button>
          <button id="credits-btn" class="gd-btn gd-btn--alt" type="button">Music credits</button>
          <button id="reset-progress" class="gd-btn gd-btn--alt" type="button">Reset progress</button>
        </div>
      </div>
    </section>

    <section id="stage" class="play" hidden>
      <h1 id="level-title" class="sr-only">First Level</h1>
      <canvas
        id="game"
        width="960"
        height="540"
        tabindex="0"
        aria-label="First Level. Arrow keys or W A S D to move and jump. R restarts at the last checkpoint. Escape pauses."
      ></canvas>
      <p id="game-status" class="sr-only" aria-live="polite"></p>
      <p id="game-help" class="help">Arrows or WASD, hold jump. R restarts. Esc pauses. M mutes. The slider sets volume.</p>
      <div class="hud-actions">
        <label class="volume">
          Volume
          <input type="range" min="0" max="100" step="1" value="60" data-volume aria-label="Music volume" />
        </label>
        <button id="mute-hud" class="gd-btn gd-btn--alt" type="button" data-mute aria-pressed="false">Mute</button>
        <button id="practice-btn" class="gd-btn gd-btn--alt" type="button" aria-pressed="false">Practice</button>
        <button id="skip-btn" class="gd-btn gd-btn--alt" type="button">Skip level</button>
        <button id="pause-btn" class="gd-btn gd-btn--alt" type="button">Pause</button>
      </div>
      <div id="layout-pause" class="layout-pause" hidden>
        <div class="layout-panel" role="region" aria-labelledby="layout-title">
          <h2 id="layout-title">Window too small</h2>
          <p>The window is too small to keep playing. Make it wider and the level will resume.</p>
          <p>
            The same writing is on the <a href={base}>Classic page</a> if you would rather leave.
          </p>
          <button id="layout-leave" class="gd-btn" type="button">Level select</button>
        </div>
      </div>
    </section>

    <dialog id="notice" aria-labelledby="notice-title">
      <h2 id="notice-title"></h2>
      <div id="notice-body"></div>
      <div class="dialog-actions">
        <button id="notice-cancel" class="gd-btn gd-btn--alt" type="button" hidden>Cancel</button>
        <button id="notice-ok" class="gd-btn" type="button">Continue</button>
      </div>
    </dialog>
    <script id="game-content" type="application/json" is:inline set:html={JSON.stringify(gameContent)}></script>
  </main>
</BaseLayout>

<script>
  import { mountGame } from "../game/main";

  const canvas = document.querySelector<HTMLCanvasElement>("#game");
  if (canvas) mountGame(canvas);
</script>

<style>
  :global(html),
  :global(body) {
    height: 100%;
  }

  :global(body:has(#stage:not([hidden]))) {
    overflow: hidden;
  }

  :global(.page) {
    display: flex;
    flex-direction: column;
    height: 100dvh;
  }

  :global(#content) {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .shell {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .select {
    flex: 1;
    min-height: 0;
    overflow: auto;
    /* Side space lives on .select-inner, so the level cards and the Hall of Fame share one width. */
    padding: 1.25rem 0 2rem;
  }

  .select-inner {
    width: min(64rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .intro {
    max-width: 40rem;
    color: var(--text-muted);
  }

  /* Visible unless the window is wide and the primary pointer is a mouse or trackpad. */
  .keyboard-note {
    display: block;
    max-width: 40rem;
    margin: 0 0 1.25rem;
    padding: 0.9rem 1rem;
    color: var(--text);
    background: rgba(7, 10, 43, 0.55);
    border: 3px solid #000;
    border-radius: 12px;
    box-shadow: 0 4px 0 #000;
  }

  .keyboard-note p {
    margin: 0 0 0.85rem;
  }

  @media (min-width: 768px) and (pointer: fine) {
    .keyboard-note {
      display: none;
    }
  }

  .cards {
    display: grid;
    /* min() lets one card shrink below 16.5rem on a phone instead of overflowing. */
    grid-template-columns: repeat(auto-fill, minmax(min(16.5rem, 100%), 1fr));
    gap: 1rem;
  }

  .select-actions .gd-btn,
  .hud-actions .gd-btn {
    padding: 0.4rem 0.85rem;
    font-size: 1rem;
  }

  .attempts {
    margin: 1rem 0 0.4rem;
    color: var(--text-muted);
  }

  /* Same width as the level cards above it, because it lives in .select-inner. Gold, but the same rounded card shape as those levels. */
  .hall {
    margin-top: 1.25rem;
    padding: 1.15rem 1.15rem 1.3rem;
    color: var(--text);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(240, 193, 75, 0.2), transparent 58%),
      linear-gradient(180deg, rgba(48, 36, 10, 0.94), rgba(7, 10, 43, 0.96));
    border: 3px solid #000;
    border-radius: 16px;
    box-shadow:
      0 0 0 2px rgba(240, 193, 75, 0.72),
      0 6px 0 #000;
  }

  .hall h2 {
    margin: 0 0 0.85rem;
    text-align: center;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    color: #ffe7a3;
    text-shadow:
      0 0 4px rgba(240, 193, 75, 0.85),
      0 0 16px rgba(240, 193, 75, 0.45);
  }

  .hall > p {
    margin: 0;
    color: var(--text);
    font-size: 0.98rem;
  }

  .hall a {
    color: #ffe7a3;
    font-weight: 600;
  }

  .hall .hall-empty {
    margin: 1.6rem 0 0;
    padding: 0.85rem 1rem;
    color: #ffe7a3;
    background: rgba(7, 10, 43, 0.45);
    border: 2px dashed rgba(240, 193, 75, 0.7);
    border-radius: 12px;
  }

  .hall-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 0.75rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hall-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.75rem;
    align-items: baseline;
    margin: 0;
    padding: 0.75rem 0.9rem;
    background: rgba(7, 10, 43, 0.62);
    border: 2px solid rgba(240, 193, 75, 0.75);
    border-radius: 12px;
    box-shadow: 0 4px 0 #000;
  }

  .hall-name {
    color: #ffe7a3;
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .hall-date {
    color: #f6e2a8;
  }

  .select-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .play {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  /* Sits on the canvas only, so the header's Classic link stays usable. */
  .layout-pause {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow: auto;
    background: rgba(4, 6, 24, 0.92);
  }

  .layout-pause[hidden] {
    display: none !important;
  }

  .layout-panel {
    width: min(28rem, 100%);
    padding: 1.25rem 1.35rem 1.15rem;
    color: var(--text);
    background: linear-gradient(180deg, rgba(16, 22, 84, 0.98), rgba(7, 10, 43, 0.98));
    border: 3px solid #000;
    border-radius: 16px;
    box-shadow:
      0 0 0 2px rgba(111, 214, 255, 0.35),
      0 6px 0 #000;
  }

  .layout-panel h2 {
    margin: 0 0 0.65rem;
    font-size: 1.7rem;
    color: var(--ice);
  }

  .layout-panel p {
    margin: 0 0 0.75rem;
  }

  .layout-panel .gd-btn {
    margin-top: 0.15rem;
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
    background: #070a2b;
    touch-action: none;
  }

  .help {
    position: absolute;
    left: 0.8rem;
    /* Sits in the sky under the level name, so it never covers the cube. */
    top: 4.15rem;
    z-index: 2;
    margin: 0;
    max-width: min(28rem, calc(100% - 12.5rem));
    color: var(--ice);
    font-size: 0.8rem;
    text-shadow:
      0 1px 2px #000,
      0 0 8px #070a2b;
    pointer-events: none;
  }

  .hud-actions {
    position: absolute;
    top: 0.45rem;
    right: 0.7rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  @media (min-width: 900px) {
    .hud-actions {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-end;
      max-width: min(40rem, calc(100% - 1.4rem));
    }
  }

  .volume {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ice);
    font-family: var(--font-display);
    font-size: 0.95rem;
  }

  .volume input[type="range"] {
    width: 7rem;
    accent-color: var(--glow-cyan);
    cursor: pointer;
  }

  /* In the corner HUD the label sits above the slider, so it stays
     narrower than the progress bar's reserved space. */
  .hud-actions .volume {
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    font-size: 0.85rem;
  }

  .hud-actions .volume input[type="range"] {
    width: 6.2rem;
  }

  #practice-btn[aria-pressed="true"] {
    color: var(--bg-deep);
    background: #7dff6a;
    box-shadow:
      0 0 12px rgba(125, 255, 106, 0.45),
      0 4px 0 #000;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #notice {
    max-width: min(34rem, calc(100% - 2rem));
    max-height: min(80dvh, 36rem);
    overflow: auto;
    padding: 1.25rem 1.35rem 1.15rem;
    color: var(--text);
    background: linear-gradient(180deg, rgba(16, 22, 84, 0.98), rgba(7, 10, 43, 0.98));
    border: 3px solid #000;
    border-radius: 16px;
    box-shadow:
      0 0 0 2px rgba(111, 214, 255, 0.35),
      0 6px 0 #000;
  }

  #notice::backdrop {
    background: rgba(4, 6, 24, 0.62);
  }

  .dialog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  /* .gd-btn sets display:inline-block, which would otherwise show a hidden button. */
  #notice [hidden] {
    display: none !important;
  }

  .dialog-actions .gd-btn {
    margin-top: 0;
  }
</style>

<style is:global>
  /* The level cards and the dialog text are built by src/game/main.ts and
     panels.ts after the page loads. Astro's scoped styles only reach elements
     written in this file, so these rules are global, kept to this page by
     starting each one with #level-cards or #notice. */
  #level-cards .card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 0.95rem 1rem;
    background: linear-gradient(180deg, rgba(16, 22, 84, 0.94), rgba(7, 10, 43, 0.96));
    border: 3px solid #000;
    border-radius: 16px;
    box-shadow:
      0 0 0 2px rgba(111, 214, 255, 0.28),
      0 6px 0 #000;
  }

  #level-cards .card[data-state="locked"] {
    opacity: 0.55;
  }

  #level-cards .card[data-state="cleared"] {
    box-shadow:
      0 0 0 2px rgba(255, 159, 191, 0.55),
      0 6px 0 #000;
  }

  #level-cards .card h2 {
    margin: 0.35rem 0 0;
    font-size: 1.45rem;
  }

  #level-cards .card p {
    margin: 0;
  }

  #level-cards .face {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }

  #level-cards .diff {
    font-family: var(--font-display);
    color: var(--ice);
    font-size: 1.05rem;
  }

  #level-cards .song,
  #level-cards .section {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  #level-cards .badge {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    letter-spacing: 0.02em;
  }

  #level-cards .card[data-state="open"] .badge {
    color: var(--glow-cyan);
  }

  #level-cards .card[data-state="cleared"] .badge {
    color: var(--accent-pink);
  }

  #level-cards .card[data-state="practice"] {
    box-shadow:
      0 0 0 2px rgba(143, 107, 255, 0.55),
      0 6px 0 #000;
  }

  #level-cards .card[data-state="practice"] .badge {
    color: var(--glow-violet);
  }

  #level-cards .card[data-state="skipped"] {
    box-shadow:
      0 0 0 2px rgba(159, 179, 217, 0.5),
      0 6px 0 #000;
  }

  #level-cards .card[data-state="skipped"] .badge {
    color: var(--text-muted);
  }

  #level-cards .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.75rem;
  }

  #level-cards .card-actions .gd-btn {
    padding: 0.4rem 0.85rem;
    font-size: 1rem;
  }

  #notice h2 {
    margin: 0 0 0.65rem;
    font-size: 1.7rem;
    color: var(--ice);
  }

  #notice h2 a {
    color: inherit;
    text-decoration: none;
  }

  #notice h2 a:hover {
    color: var(--glow-cyan);
  }

  #notice h3 {
    margin: 0.85rem 0 0.3rem;
    font-size: 1.15rem;
  }

  /* Featured puts the item name directly under the "Featured" title. */
  #notice-body > h3:first-child {
    margin-top: 0;
  }

  #notice p,
  #notice li {
    font-size: 1.02rem;
  }

  #notice .dates,
  #notice .org {
    margin-top: 0;
    color: var(--text-muted);
  }

  #notice .bullets,
  #notice .awards,
  #notice .contact {
    margin: 0.45rem 0 0;
    padding-left: 1.15rem;
  }

  #notice .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  #notice .tags li {
    padding: 0.1rem 0.5rem;
    border: 2px solid rgba(111, 214, 255, 0.4);
    border-radius: 999px;
    color: var(--ice);
    font-size: 0.78rem;
  }

  #notice .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-weight: 600;
  }

  #notice .contact {
    list-style: none;
    padding-left: 0;
  }

  #notice .contact li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.35rem 0;
  }

  #notice .label {
    font-family: var(--font-display);
    color: var(--ice);
  }

  #notice .awards {
    list-style: none;
    padding-left: 0;
  }

  #notice .credits {
    margin: 0.45rem 0 0;
    padding: 0;
    list-style: none;
  }

  #notice .credits li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 1rem;
    margin: 0.55rem 0;
  }

  #notice .credits li > span {
    grid-column: 1;
  }

  #notice .credits li > span:nth-child(2) {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  #notice .credits a {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-weight: 600;
  }

  #notice .awards li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    margin: 0.45rem 0;
  }

  #notice .date {
    font-family: var(--font-display);
    color: var(--glow-cyan);
    white-space: nowrap;
  }
</style>
