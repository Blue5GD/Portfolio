---
import { identity } from "../data/identity";
---

<footer>
  <p class="brand wordmark">{identity.brand}</p>
  <p class="meta">{identity.name} · {identity.tagline}</p>
  <p class="meta"><a href="#hero">Back to top</a></p>
</footer>

<style>
  footer {
    margin-top: 0.5rem;
    padding: 1.5rem 1.25rem 2.25rem;
    text-align: center;
    border-top: 1px solid rgba(111, 214, 255, 0.18);
  }

  .brand {
    margin: 0 0 0.35rem;
    font-size: 1.6rem;
  }

  .meta {
    margin: 0.2rem 0;
    color: var(--text-muted);
  }
</style>
