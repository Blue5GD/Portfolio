---
import type { SkillGroup } from "../data/types";

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="groups">
  {
    groups.map((group) => (
      <section>
        <h3>{group.name}</h3>
        <ul>
          {group.skills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem 2rem;
  }

  @media (min-width: 700px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }

  h3 {
    margin: 0 0 0.45rem;
    font-size: 1.2rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.12rem 0.55rem;
    border: 2px solid rgba(111, 214, 255, 0.4);
    border-radius: 999px;
    background: rgba(111, 214, 255, 0.08);
    color: var(--ice);
    font-size: 0.85rem;
  }
</style>
