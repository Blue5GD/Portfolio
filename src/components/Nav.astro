---
import ModeToggle, { type Mode } from "./ModeToggle.astro";
import { identity } from "../data/identity";

interface Props {
  mode: Mode;
}

const { mode } = Astro.props;
const base = import.meta.env.BASE_URL;

// These ids exist only on the classic page. Hash links stay on this page.
const sections = [
  { href: "#hero", label: "Hero" },
  { href: "#featured", label: "Featured" },
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#experience", label: "Experience" },
  { href: "#awards", label: "Awards" },
  { href: "#skills", label: "Skills" },
  { href: "#education", label: "Education" },
  { href: "#contact", label: "Contact" },
];
---

<header class="nav">
  <nav class="bar" aria-label="Main">
    <a class="logo wordmark" href={base}>{identity.brand}</a>
    <div class="bar-end">
      {
        mode === "classic" && (
          <details class="section-menu">
            <summary>Contents</summary>
            <nav aria-label="On this page">
              {sections.map((section) => (
                <a href={section.href}>{section.label}</a>
              ))}
            </nav>
          </details>
        )
      }
      <ModeToggle current={mode} />
    </div>
  </nav>
</header>

<script>
  // The menu is a <details> element, so it opens and closes without extra code.
  // This only tidies it up: click outside, press Escape, or pick a section, and it shuts.
  const menu = document.querySelector<HTMLDetailsElement>(".section-menu");
  if (menu) {
    document.addEventListener("click", (event) => {
      if (!menu.open) return;
      if (event.target instanceof Node && menu.contains(event.target)) return;
      menu.open = false;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") menu.open = false;
    });

    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    }
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(7, 10, 43, 0.75);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(111, 214, 255, 0.15);
  }

  /* Same single row as before the section links existed. The menu hangs over the page, so it does not stretch this bar. */
  .bar {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0.6rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .logo {
    font-size: 1.6rem;
    text-decoration: none;
  }

  .section-menu {
    position: relative;
  }

  summary {
    padding: 0.35rem 0.9rem;
    border: 2px solid rgba(111, 214, 255, 0.35);
    border-radius: 999px;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--text);
    background: rgba(7, 10, 43, 0.7);
    cursor: pointer;
    white-space: nowrap;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: " ▾";
  }

  .section-menu[open] summary::after {
    content: " ▴";
  }

  summary:hover {
    color: var(--glow-cyan);
    border-color: rgba(111, 214, 255, 0.7);
  }

  .section-menu nav {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    z-index: 20;
    min-width: 11.5rem;
    padding: 0.35rem;
    display: flex;
    flex-direction: column;
    background: rgba(7, 10, 43, 0.96);
    border: 2px solid rgba(111, 214, 255, 0.35);
    border-radius: 12px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
  }

  .section-menu nav a {
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.15;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-menu nav a:hover {
    color: var(--glow-cyan);
    background: rgba(111, 214, 255, 0.12);
  }

  /* The logo, Contents, and Classic/Play toggle have to share one row on a phone. */
  @media (max-width: 480px) {
    .bar {
      padding: 0.5rem 0.75rem;
    }

    .bar-end {
      gap: 0.4rem;
    }

    .logo {
      font-size: 1.2rem;
    }

    summary {
      padding: 0.28rem 0.55rem;
      font-size: 0.85rem;
    }

    .bar-end :global(.mode-toggle a) {
      padding: 0.3rem 0.55rem;
      font-size: 0.9rem;
    }
  }
</style>
