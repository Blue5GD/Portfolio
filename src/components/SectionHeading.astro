---
// The title row at the top of every classic-mode section.
// The bar is decoration (the same kind of bar a game level card uses).
// It is aria-hidden so a screen reader does not announce a fake percentage.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="heading">
  <h2>{title}</h2>
  <div class="bar" aria-hidden="true"><span></span></div>
</div>

<style>
  .heading {
    margin-bottom: 1.15rem;
  }

  h2 {
    margin-bottom: 0.55rem;
    font-size: clamp(1.7rem, 3vw, 2.25rem);
    text-wrap: balance;
  }

  .bar {
    height: 12px;
    background: var(--spike);
    border: 2px solid #000;
    border-radius: 999px;
    overflow: hidden;
    box-shadow: inset 0 2px 0 rgba(0, 0, 0, 0.45);
  }

  .bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(180deg, #e9f9ff 0%, var(--glow-cyan) 42%, #3aa4d4 100%);
    box-shadow: 0 0 10px var(--glow-cyan);
    animation: fill 0.9s ease-out;
  }

  @keyframes fill {
    from {
      width: 0;
    }
  }
</style>
