---
import Cube from "./Cube.astro";
import { identity } from "../data/identity";

const base = import.meta.env.BASE_URL;
---

<section id="hero" class="hero">
  <div class="beam" aria-hidden="true"></div>

  <Cube size={150} bounce />

  <p class="brand wordmark">{identity.brand}</p>
  <h1>{identity.name}</h1>
  <p class="tagline">{identity.tagline}</p>

  <div class="actions">
    <a class="gd-btn" href="#projects">Projects</a>
    <a class="gd-btn gd-btn--alt" href={`${base}${identity.resumeFile}`} target="_blank" rel="noopener">
      Resume (PDF)
    </a>
    <a class="gd-btn gd-btn--alt" href={`${base}play`} data-mode="play">Play the site</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem 4rem;
    overflow: hidden;
    isolation: isolate; /* keeps the beam's z-index: -1 behind the hero's content, not behind the page */
  }

  /* Vertical light beam behind the cube, like the avatar. */
  .beam {
    position: absolute;
    inset: 0 auto 0 50%;
    width: min(340px, 70vw);
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at 50% 35%,
      rgba(111, 214, 255, 0.35) 0%,
      rgba(111, 214, 255, 0.12) 40%,
      transparent 70%
    );
    filter: blur(6px);
    pointer-events: none;
    z-index: -1;
  }

  .brand {
    margin: 1.75rem 0 0.25rem;
    font-size: clamp(3.25rem, 11vw, 6.5rem);
    line-height: 1;
  }

  h1 {
    margin: 0.5rem 0 0.25rem;
    font-size: clamp(1.6rem, 4.5vw, 2.4rem);
    color: var(--text);
  }

  .tagline {
    margin: 0 0 2rem;
    font-size: 1.15rem;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
